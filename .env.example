# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─── Supabase (Opsional - untuk sinkronisasi data antar device) ─────────────
# Jika tidak diisi, aplikasi tetap jalan menggunakan localStorage (offline).
# Jika diisi, semua data akan tersimpan di Supabase PostgreSQL dan bisa diakses
# dari device/browser mana pun secara real-time.
#
# Cara mendapatkannya:
# 1. Buat akun gratis di https://supabase.com
# 2. Buat project baru
# 3. Buka Settings > API, copy "Project URL" dan "anon public" key
# 4. Buka SQL Editor, paste isi file `supabase-schema.sql`, lalu klik Run
#
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
